{
  "langrev": "1",
  "dependency-search-paths": [
    "lib",
    "lib/c3d.c3l/addons",
    "lib/c3d.c3l/lib",
    "lib/c3d.c3l/lib/gpu.c3l/lib",
    ".."
  ],
  "dependencies": [
    "c3d_fracture",
    "c3d",
    "gpu",
    "vk",
    "vma",
    "spvreflect",
    "sdl3",
    "c3imgui",
    "c3cg",
    "cgltf",
    "ufbx"
  ],
  "fp-math": "strict",
  "wincrt": "static",
  "output": "build",
  "targets": {
    "basic": {
      "type": "executable",
      "sources": [
        "examples/basic.c3"
      ]
    },
    "unit": {
      "type": "test",
      "sources": [
        "test/unit/*"
      ]
    },
    "collision_integration": {
      "type": "test",
      "dependencies": [
        "c3d_fracture",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "cgltf",
        "ufbx",
        "c3d_physics",
        "b3"
      ],
      "sources": [
        "test/integration/*"
      ]
    }
  }
}
